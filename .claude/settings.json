{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run export --silent && git add export/iavocat.html",
            "statusMessage": "Régénération de l'export…"
          }
        ]
      }
    ]
  }
}
